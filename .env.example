# Optional, and worth two minutes.
#
# Without these, OVERHEAD calls OpenSky anonymously: 400 credits a day, counted per IP, shared by
# everyone behind it. A free API client raises that to 4,000.
#
#   1. Sign in at https://opensky-network.org/my-opensky/account
#   2. Create an API client and copy the id and secret
#   3. Save this file as `.env` with the values filled in, then restart the dev server
#
# The same two variables are read in development and in production -- both run `api/states.ts`.
# They are never sent to the browser.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
